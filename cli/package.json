{
  "name": "mcp-hub",
  "version": "1.4.0",
  "description": "The homebrew for MCP servers — install any Model Context Protocol server in one command. Auto-configures Claude Desktop, Cursor, Cline, and Windsurf.",
  "type": "module",
  "bin": {
    "mcp-hub": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "node tests/smoke-test.js",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "cline",
    "windsurf",
    "ai",
    "llm",
    "tools",
    "installer",
    "directory"
  ],
  "license": "MIT",
  "author": "Mayank Bhaskar",
  "repository": {
    "type": "git",
    "url": "https://github.com/e2sy/mcp-hub.git"
  },
  "homepage": "",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
